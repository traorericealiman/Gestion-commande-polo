# Copier ce fichier en `.env` puis adapter les valeurs.
# Le fichier `.env` ne doit JAMAIS être commité (il est dans .gitignore).

# --- Base ---
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=a-remplacer-par-une-vraie-cle
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# PostgreSQL installé sur la machine : port 5432 (voir README).
# Avec Docker (docker compose up -d) : remplacer 5432 par 5433.
DATABASE_URL=postgres://polo:polo_dev_password@localhost:5432/polo_esatic

# --- Front React autorisé (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173
# Route de la page de suivi du front, utilisée dans les liens des emails.
FRONTEND_ROUTE_SUIVI=/suivi

# --- Fichiers privés (captures de paiement) ---
# PRIVATE_MEDIA_ROOT=/chemin/absolu/hors/du/dossier/public

# --- Emails ---
# En local, les emails s'affichent dans la console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# En production :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Polos ESATIC <no-reply@example.com>

# --- Limites anti-abus ---
THROTTLE_LOGIN=5/min
THROTTLE_COMMANDE=10/hour
THROTTLE_SUIVI=30/min

# --- Jetons de connexion ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=8
